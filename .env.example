# Fictional commercial data, public local-only demo tokens, no commercial actions.
# The app does not auto-load .env. Export these variables in your shell.
COPILOT_MODE=demo
COPILOT_DB_PATH=.local/sales.sqlite
# 0 = initial/manual analysis only; >=10 = periodic scan, seconds.
SALES_SCAN_INTERVAL_SECONDS=0
# offline = explicit local simulation; bedrock = AWS, never silent fallback.
SALES_AI_MODE=offline
SALES_BEDROCK_MODEL=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# Configure temporary credentials outside this repo; never put them in this file.
# AWS_PROFILE=sales-hackathon
# Optional trusted synthetic snapshot; otherwise use the packaged demo fixture.
# SALES_SNAPSHOT_PATH=.local/backoffice-demo.json
